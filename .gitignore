# ==============================================================================
# AI Sentiment Intelligence - Git Ignore Rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest cache
.pytest_cache/

# Python Virtual Environments
.venv/
venv/
env/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Operating System Files
.DS_Store
Thumbs.db

# Build, Distribution & Packaging Artifacts
*.egg-info/
dist/
build/

# Local Environment Variables & Secrets
.env
.env.local

# IDE and Code Editor Settings
.idea/
.vscode/

# Log Files
*.log

# Pickle files - ignore general pickle files, but keep trained model artifacts in models/
*.pkl
!models/*.pkl

# ==============================================================================
# Node.js / Next.js / Vercel Frontend Artifacts
# ==============================================================================
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Note: Source code, notebooks, documentation, README, requirements.txt, and dataset files are tracked.
